{
  "name": "@builtbyfield/maplibre-expr",
  "type": "module",
  "version": "0.1.1",
  "packageManager": "pnpm@10.34.7",
  "description": "Typed builders for MapLibre style expressions. Wrong compositions fail to compile, output is plain spec JSON.",
  "author": {
    "name": "Jesse McLean",
    "email": "jesse@builtbyfield.com",
    "url": "https://www.builtbyfield.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/builtbyfield/maplibre-expr#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/builtbyfield/maplibre-expr.git"
  },
  "bugs": {
    "url": "https://github.com/builtbyfield/maplibre-expr/issues"
  },
  "keywords": [
    "maplibre",
    "maplibre-gl",
    "style-spec",
    "expressions",
    "typescript",
    "typed"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./testing": "./dist/testing.js",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test:run && pnpm build && pnpm smoke",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "pnpm check",
    "check:links": "node scripts/check-links.mjs",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "peerDependencies": {
    "@maplibre/maplibre-gl-style-spec": ">=26.3.0"
  },
  "dependencies": {
    "@types/geojson": "^7946.0.16"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@arethetypeswrong/core": "^0.18.1",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@maplibre/maplibre-gl-style-spec": "^26.4.4",
    "@types/node": "^24.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-format": "^2.0.1",
    "publint": "^0.3.25",
    "tsdown": "^0.23.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5"
  }
}
